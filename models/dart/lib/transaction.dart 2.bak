class Transaction {
  String id;
  String transactionId;
  String potId;
  String OnchainTransactionId;
  String LightningTransactionId;
  Transaction(this.id, this.transactionId, this.potId,
      this.OnchainTransactionId, this.LightningTransactionId) {}
  static fromJson(Object json) {
    return new Transaction(json["id"], json["transactionId"], json["potId"],
        json["OnchainTransactionId"], json["LightningTransactionId"]);
  }
}
