    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "flutter - widgetbook",
            "cwd": "app",
            "request": "launch",
            "program": "widgetbook/lib/main.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=mock",
            ]
        },
        {
            "name": "flutter - mock",
            "cwd": "app",
            "request": "launch",
            "program": "lib/main_mock.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=mock",
            ]
        },
        {
            "name": "flutter - development",
            "cwd": "app",
            "request": "launch",
            "program": "lib/main_dev.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=dev",
            ]
        },
        {
            "name": "flutter - test",
            "cwd": "app",
            "request": "launch",
            "program": "lib/main_test.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=test",
            ]
        },
        {
            "name": "flutter - staging",
            "cwd": "app",
            "request": "launch",
            "program": "lib/main_staging.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=staging",
            ]
        },
        {
            "name": "flutter - production",
            "cwd": "app",
            "request": "launch",
            "program": "lib/main_prod.dart",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=prod",
            ]
        },
        {
            "name": "flutter (profile mode)",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter (release mode)",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}