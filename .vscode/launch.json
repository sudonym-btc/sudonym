        {
            "name": "flutter - development",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=dev",
            ]
        },
        {
            "name": "flutter - staging",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=staging",
            ]
        },
        {
            "name": "flutter - production",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "ENV=prod",
            ]
        },
        {
            "name": "flutter (profile mode)",
            "cwd": "flutter",
            "request": "launch",
            "type": "dart",
