{
  "name": "sudonym",
  "version": "0.0.1",
  "description": "sudonym monorepo",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "init:gcloud": "bash ops/infrastructure/setup.sh",
    "deploy:production": "bash ops/infrastructure/deploy.sh production",
    "deploy:staging": "bash ops/infrastructure/deploy.sh staging",
    "deploy:test": "bash ops/infrastructure/deploy.sh test",
    "deploy:development": "python3 ops/infrastructure/minikube.py && minikube start && minikube kubectl -- apply -f ops/infrastructure/minikube.yaml --validate=false && minikube dashboard &>/dev/null",
    "minikube:tunnel": "minikube addons enable ingress && minikube addons enable ingress-dns && minikube tunnel",
    "app:mock": "cd flutter && flutter run",
    "app:development": "flutter run --backend=development",
    "app:staging": "flutter run --backend=staging",
    "app:production": "flutter run --backend=production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudonym-btc/sudonym.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sudonym-btc/sudonym/issues"
  },
  "homepage": "https://github.com/sudonym-btc/sudonym#readme"
}