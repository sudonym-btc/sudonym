{
  "name": "@sudonym/api",
  "version": "0.0.1",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "getConfig": "GCLOUD_PROJECT=$(gcloud config get project) ts-node src/helper/config-loader.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/database/seeder.ts",
    "test": "NODE_ENV=mock jest --detectOpenHandles --forceExit",
    "test:watch": "NODE_ENV=mock jest --watch",
    "test:cov": "NODE_ENV=mock jest --coverage",
    "test:debug": "NODE_ENV=mock node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fitbit/jsonrpc-ts": "^3.2.1",
    "@google-cloud/storage": "^6.4.2",
    "@nestjs/common": "^8.4.0",
    "@nestjs/core": "^8.4.0",
    "@nestjs/platform-express": "^8.4.0",
    "@nestjs/platform-socket.io": "^8.4.1",
    "@nestjs/swagger": "^5.2.0",
    "@nestjs/websockets": "^8.4.1",
    "@therms/rpc-client": "^2.2.3",
    "@types/zeromq": "^5.2.1",
    "axios": "^0.26.0",
    "bitcoinjs-lib": "^6.0.1",
    "bolt11": "^1.3.4",
    "ccxt": "^1.93.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "cls-hooked": "^4.2.2",
    "command-line-args": "^5.2.1",
    "fetch": "^1.1.0",
    "firebase-admin": "^10.0.2",
    "jsonrpc-ts": "^0.2.1",
    "lnurl": "^0.21.0",
    "madge": "^5.0.1",
    "mysql2": "^2.3.3",
    "node-fetch": "^2.6.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.4",
    "sequelize": "^6.21.1",
    "sequelize-typescript": "^2.1.3",
    "swagger-ui-express": "^4.3.0",
    "unique-username-generator": "^1.1.1",
    "url": "^0.11.0",
    "uuid": "^8.3.2",
    "ws": "^8.5.0",
    "zeromq": "^5.2.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.1.3",
    "@nestjs/schematics": "^8.0.4",
    "@nestjs/testing": "^8.1.1",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.0.2",
    "@types/node": "^17.0.21",
    "@types/supertest": "^2.0.11",
    "@types/validator": "^13.7.1",
    "jest": "^27.3.0",
    "source-map-support": "^0.5.20",
    "sqlite3": "^5.0.8",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.3.0",
    "tsconfig-paths": "^3.11.0",
    "typescript": "^4.4.4",
    "wait-for-expect": "^3.0.2"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "roots": [
      "src"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
