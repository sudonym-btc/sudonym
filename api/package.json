{
  "name": "@sudonym/api",
  "version": "0.0.1",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "getConfig": "GCLOUD_PROJECT=$(gcloud config get project) ts-node src/helper/config-loader.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/database/seeder.ts",
    "pretest": "npm run docker:test",
    "pretest:watch": "npm run pretest",
    "pretest:cov": "npm run pretest",
    "pretest:debug": "npm run pretest",
    "test": "NODE_ENV=mock jest --forceExit",
    "test:watch": "NODE_ENV=mock jest --watch",
    "test:cov": "NODE_ENV=mock jest --coverage",
    "test:debug": "NODE_ENV=mock node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "docker:test": "docker start $(docker container ls -f name=mysql --format='{{.ID}}') || docker run --name mysql -e MYSQL_ALLOW_EMPTY_PASSWORD=1 -d -p 3306:3306 mysql:8"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fitbit/jsonrpc-ts": "^3.2.1",
    "@google-cloud/storage": "^6.6.0",
    "@nestjs/common": "^8.4.7",
    "@nestjs/core": "^8.4.7",
    "@nestjs/jwt": "^9.0.0",
    "@nestjs/platform-express": "^8.4.7",
    "@nestjs/platform-socket.io": "^8.4.7",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/websockets": "^8.4.7",
    "@therms/rpc-client": "^2.11.4",
    "@types/zeromq": "^5.2.1",
    "axios": "^0.26.1",
    "bitcoin-address-validation": "^2.2.1",
    "bitcoinjs-lib": "^6.0.2",
    "bolt11": "^1.4.0",
    "ccxt": "^1.95.43",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "cls-hooked": "^4.2.2",
    "command-line-args": "^5.2.1",
    "fetch": "^1.1.0",
    "firebase-admin": "^10.3.0",
    "jsonrpc-ts": "^0.2.1",
    "lnurl": "^0.21.0",
    "madge": "^5.0.1",
    "mysql2": "^2.3.3",
    "node-fetch": "^2.6.7",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.7",
    "sequelize": "^6.25.3",
    "sequelize-typescript": "^2.1.5",
    "swagger-ui-express": "^4.5.0",
    "unique-username-generator": "^1.1.1",
    "url": "^0.11.0",
    "uuid": "^8.3.2",
    "ws": "^8.10.0",
    "zeromq": "^5.2.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.2.8",
    "@nestjs/schematics": "^8.0.11",
    "@nestjs/testing": "^8.4.7",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.14",
    "@types/jest": "^27.5.2",
    "@types/node": "^17.0.21",
    "@types/supertest": "^2.0.12",
    "@types/validator": "^13.7.9",
    "conditional-decorator": "^0.1.7",
    "jest": "^27.5.1",
    "source-map-support": "^0.5.20",
    "sqlite3": "^5.1.2",
    "supertest": "^6.3.1",
    "ts-jest": "^27.1.5",
    "ts-loader": "^9.4.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^3.11.0",
    "typescript": "^4.8.4",
    "wait-for-expect": "^3.0.2"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "roots": [
      "src"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
