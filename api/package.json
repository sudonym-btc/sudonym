{
	"name": "@sudonym/api",
	"version": "0.0.1",
	"description": "",
	"main": "dist/main.js",
	"scripts": {
		"build": "nest build --path tsconfig.json",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"getConfig": "GCLOUD_PROJECT=$(gcloud config get project) ts-node src/helper/config-loader.ts",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"seed": "ts-node src/database/seeder.ts",
		"pretest": "npm run docker:test",
		"pretest:watch": "npm run pretest",
		"pretest:cov": "npm run pretest",
		"pretest:debug": "npm run pretest",
		"test": "NODE_ENV=mock jest --forceExit",
		"test:watch": "NODE_ENV=mock jest --watch",
		"test:cov": "NODE_ENV=mock jest --coverage",
		"test:debug": "NODE_ENV=mock node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"docker:test": "eval $(minikube docker-env -u) && docker start $(docker container ls -a -f name=mysql --format='{{.ID}}') || docker run --name mysql -e MYSQL_ALLOW_EMPTY_PASSWORD=1 -d -p 3306:3306 mysql:8"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@google-cloud/storage": "^6.6.0",
		"@nestjs/common": "^9.2.1",
		"@nestjs/core": "^9.2.1",
		"@nestjs/jwt": "^9.0.0",
		"@nestjs/platform-express": "^9.2.1",
		"@nestjs/platform-socket.io": "^9.2.1",
		"@nestjs/swagger": "^6.1.3",
		"@nestjs/websockets": "^9.2.1",
		"@sentry/node": "^7.21.1",
		"@sentry/tracing": "^7.21.1",
		"@types/zeromq": "^5.2.1",
		"axios": "^1.2.0",
		"bitcoin-address-validation": "^2.2.1",
		"bitcoinjs-lib": "^6.1.0-rc.0",
		"bolt11": "^1.4.0",
		"ccxt": "^2.2.46",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.13.2",
		"cls-hooked": "^4.2.2",
		"command-line-args": "^5.2.1",
		"conditional-decorator": "^0.1.7",
		"firebase-admin": "^11.3.0",
		"lnurl": "^0.24.2",
		"mysql2": "^2.3.3",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.5.7",
		"segfault-handler": "^1.3.0",
		"sequelize": "^6.25.3",
		"sequelize-typescript": "^2.1.5",
		"swagger-ui-express": "^4.5.0",
		"unique-username-generator": "^1.1.3",
		"uuid": "^9.0.0",
		"ws": "^8.10.0",
		"zeromq": "^5.2.8"
	},
	"devDependencies": {
		"@nestjs/cli": "^9.1.5",
		"@nestjs/schematics": "^9.0.3",
		"@nestjs/testing": "^9.2.1",
		"@types/express": "^4.17.14",
		"@types/jest": "^29.2.3",
		"@types/node": "^18.11.9",
		"@types/supertest": "^2.0.12",
		"@types/validator": "^13.7.9",
		"jest": "^29.3.1",
		"sequelize-cli": "^6.5.2",
		"source-map-support": "^0.5.20",
		"sqlite3": "^5.1.2",
		"supertest": "^6.3.1",
		"ts-jest": "^29.0.3",
		"ts-loader": "^9.4.1",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.1.0",
		"typescript": "^4.8.4",
		"wait-for-expect": "^3.0.2"
	},
	"jest": {
		"moduleDirectories": [
			"node_modules",
			"src"
		],
		"roots": [
			"src"
		],
		"testRegex": ".spec.ts$",
		"transform": {
			"^.+\\.ts$": "ts-jest"
		},
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
