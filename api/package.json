{
  "name": "@sudonym/api",
  "version": "0.0.1",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "getConfig": "ts-node src/helper/config-loader.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed": "ts-node src/database/seeder.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./src/test/jest-e2e.json",
    "test:e2e:watch": "jest --config ./src/test/jest-e2e.json --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fitbit/jsonrpc-ts": "^3.2.1",
    "@google-cloud/storage": "^6.4.2",
    "@nestjs/common": "^8.4.0",
    "@nestjs/core": "^8.4.0",
    "@nestjs/platform-express": "^8.4.0",
    "@nestjs/platform-socket.io": "^8.4.1",
    "@nestjs/swagger": "^5.2.0",
    "@nestjs/websockets": "^8.4.1",
    "@therms/rpc-client": "^2.2.3",
    "@types/zeromq": "^5.2.1",
    "axios": "^0.26.0",
    "bitcoinjs-lib": "^6.0.1",
    "bolt11": "^1.3.4",
    "cls-hooked": "^4.2.2",
    "command-line-args": "^5.2.1",
    "fetch": "^1.1.0",
    "firebase-admin": "^10.0.2",
    "jsonrpc-ts": "^0.2.1",
    "lnurl": "^0.21.0",
    "node-fetch": "^2.6.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.4",
    "sequelize": "^6.21.1",
    "sequelize-typescript": "^2.1.3",
    "swagger-ui-express": "^4.3.0",
    "url": "^0.11.0",
    "uuid": "^8.3.2",
    "ws": "^8.5.0",
    "zeromq": "^5.2.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.1.3",
    "@nestjs/schematics": "^8.0.4",
    "@nestjs/testing": "^8.1.1",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.0.2",
    "@types/node": "^17.0.21",
    "@types/supertest": "^2.0.11",
    "@types/validator": "^13.7.1",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "@typescript-eslint/parser": "^5.30.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^27.3.0",
    "prettier": "^2.7.1",
    "source-map-support": "^0.5.20",
    "sqlite3": "^5.0.8",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.3.0",
    "tsconfig-paths": "^3.11.0",
    "typescript": "^4.4.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
